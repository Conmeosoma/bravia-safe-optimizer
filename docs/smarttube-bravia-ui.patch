+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- Neutral TV surfaces keep thumbnails and remote focus visually distinct. -->
+    <color name="scheme_grey_background">#0F0F0F</color>
+    <color name="scheme_grey_background_dark">#0F0F0F</color>
+    <color name="scheme_grey_shelf_background_dark">#0F0F0F</color>
+    <color name="scheme_grey_card_background_dark">#0F0F0F</color>
+    <color name="card_selected_background_white">#272727</color>
+    <color name="card_selected_text_grey">#F1F1F1</color>
+    <color name="card_default_text">#F1F1F1</color>
+    <color name="semi_red">#FF0033</color>
+    <color name="red">#FF0033</color>
+
+    <dimen name="card_width">200dp</dimen>
+    <dimen name="card_height">112.5dp</dimen>
+    <dimen name="grid_item_horizontal_spacing">18dp</dimen>
+    <dimen name="grid_item_vertical_spacing">24dp</dimen>
+    <dimen name="browse_headers_vertical_spacing">6dp</dimen>
+    <dimen name="lb_rounded_rect_corner_radius">10dp</dimen>
+    <dimen name="lb_basic_card_info_height">64dp</dimen>
+    <dimen name="lb_basic_card_info_padding">8dp</dimen>
+    <dimen name="lb_basic_card_title_text_size">16sp</dimen>
+    <dimen name="lb_basic_card_content_text_size">12sp</dimen>
+
+    <style name="App.Theme.DarkGrey.Browse" parent="App.Theme.Leanback.Browse">
+        <item name="android:windowBackground">@color/scheme_grey_shelf_background_dark</item>
+        <item name="brandColor">@color/scheme_grey_background_dark</item>
+        <item name="brandAccentColor">@color/semi_red</item>
+        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Dark</item>
+        <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
+        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
+        <item name="appLogo">@null</item>
+        <item name="android:fontFamily">sans-serif</item>
+    </style>
+</resources>
