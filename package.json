{
  "name": "sony-bravia-safe-optimizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "test:ui": "node scripts/ui-smoke.mjs",
    "build": "npm run typecheck && npm run build -w @bravia/shared && npm run build -w @bravia/backend && npm run build -w @bravia/frontend",
    "dev": "npm run build -w @bravia/shared && concurrently -k -n API,UI \"npm run dev -w @bravia/backend\" \"npm run dev -w @bravia/frontend\"",
    "start": "node packages/backend/dist/backend/src/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
